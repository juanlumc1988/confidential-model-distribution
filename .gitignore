# ---------------------------------------------------------------------------
# Key material and credentials
#
# Nothing in this repository should ever contain a private key or a token.
# These patterns are a backstop, not the control: keys live in Kubernetes
# Secrets and in the local environment, never in the tree.
# ---------------------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.age
key.bin
*.secret
secrets/
.env
.env.*
!.env.example
.hf_token
kubeconfig
*.kubeconfig

# Public keys are meant to be committed (Layer 2 verification depends on it).
!*.pub
!*public*.pem

# ---------------------------------------------------------------------------
# Model artifacts, plaintext and ciphertext
#
# Models are pulled from the Hub at build or run time. Committing either the
# plaintext model or the encrypted artifact would defeat the point of the
# exercise and bloat the repository.
# ---------------------------------------------------------------------------
models/
artifacts/
work/
*.safetensors
*.bin
*.onnx
*.ckpt
*.pt
*.pth
*.h5
*.msgpack
*.enc
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Hugging Face and ML caches
# ---------------------------------------------------------------------------
.cache/
.huggingface/
hf_cache/
transformers_cache/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Producer output
out/
